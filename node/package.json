    "./catalog": "./catalog.snapshot.json",
    "./catalog-schema": "./catalog.schema.snapshot.json"
  },
  "files": [
    "index.js",
    "account-client.js",
    "catalog.snapshot.json",
    "catalog.schema.snapshot.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/core.test.js test/account-client.test.js"
  },
